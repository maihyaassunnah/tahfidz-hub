// Prisma Schema untuk SIMTAH (Tahfidz Hub)
// PostgreSQL Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cabang {
  id              String                @id @db.VarChar(64)
  nama            String                @db.VarChar(255)
  kode            String                @unique @db.VarChar(32)
  kota            String?               @db.VarChar(100)
  alamat          String?               @db.Text
  noHp            String?               @map("no_hp") @db.VarChar(32)
  penanggungJawab String?               @map("penanggung_jawab") @db.VarChar(150)
  email           String?               @db.VarChar(100)
  status          String?               @default("Aktif") @db.VarChar(32)
  warnaAksen      String?               @default("#0d9488") @map("warna_aksen") @db.VarChar(16)
  didirikan       String?               @db.VarChar(16)
  createdAt       DateTime?             @default(now()) @map("created_at") @db.Timestamptz(6)

  pengampu        Pengampu[]
  halaqah         Halaqah[]
  santri          Santri[]
  sesi            Sesi[]
  superadmins     SuperadminAccounts[]
  pembayaranSpp   PembayaranSPP[]
  kelasList       Kelas[]
  alumniList      Alumni[]
  lokasiQrList    LokasiQr[]
  fotoProfilList  FotoProfil[]

  @@map("cabang")
}

model SuperadminAccounts {
  id        String    @id @db.VarChar(64)
  nama      String    @db.VarChar(150)
  username  String    @unique @db.VarChar(100)
  password  String    @db.VarChar(255)
  role      String?   @default("Super Admin Cabang") @db.VarChar(64)
  cabangId  String?   @map("cabang_id") @db.VarChar(64)
  foto      String?   @db.Text
  status    String?   @default("Aktif") @db.VarChar(32)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  cabang    Cabang?   @relation(fields: [cabangId], references: [id], onDelete: SetNull)

  @@map("superadmin_accounts")
}

model Pengampu {
  id        String    @id @db.VarChar(64)
  nip       String?   @db.VarChar(64)
  nama      String    @db.VarChar(150)
  kontak    String?   @db.VarChar(50)
  noHp      String?   @map("no_hp") @db.VarChar(50)
  role      String?   @default("Pengampu Halaqoh") @db.VarChar(64)
  halaqahId String?   @map("halaqah_id") @db.VarChar(64)
  foto      String?   @db.Text
  cabangId  String?   @map("cabang_id") @db.VarChar(64)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  cabang    Cabang?   @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  halaqahList Halaqah[]
  setoranList SetoranSantri[]
  monitoringList MonitoringSigap[]
  nilaiRaporList NilaiRapor[]

  @@map("pengampu")
}

model Halaqah {
  id          String    @id @db.VarChar(64)
  nama        String    @db.VarChar(150)
  pengampuId  String?   @map("pengampu_id") @db.VarChar(64)
  target      String?   @db.VarChar(100)
  keterangan  String?   @db.Text
  cabangId    String?   @map("cabang_id") @db.VarChar(64)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  cabang      Cabang?   @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  pengampu    Pengampu? @relation(fields: [pengampuId], references: [id], onDelete: SetNull)
  santriList  Santri[]

  @@map("halaqah")
}

model Santri {
  id          String    @id @db.VarChar(64)
  nis         String?   @db.VarChar(64)
  nama        String    @db.VarChar(150)
  kelas       String?   @db.VarChar(50)
  halaqahId   String?   @map("halaqah_id") @db.VarChar(64)
  status      String?   @default("Aktif") @db.VarChar(32)
  target      String?   @db.VarChar(100)
  kontak      String?   @db.VarChar(50)
  wali        String?   @db.VarChar(150)
  noHpWali    String?   @map("no_hp_wali") @db.VarChar(50)
  cabangId    String?   @map("cabang_id") @db.VarChar(64)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  cabang      Cabang?   @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  halaqah     Halaqah?  @relation(fields: [halaqahId], references: [id], onDelete: SetNull)
  absensiList     AbsensiSantri[]
  setoranList     SetoranSantri[]
  pembayaranSpp   PembayaranSPP[]
  nilaiRaporList  NilaiRapor[]

  @@map("santri")
}

model Sesi {
  id             String    @id @db.VarChar(64)
  nama           String    @db.VarChar(100)
  jamMulai       String    @map("jam_mulai") @db.VarChar(16)
  jamSelesai     String    @map("jam_selesai") @db.VarChar(16)
  toleransiMenit Int?      @default(15) @map("toleransi_menit")
  hari           String?   @default("Setiap Hari") @db.VarChar(50)
  status         String?   @default("Aktif") @db.VarChar(32)
  cabangId       String?   @map("cabang_id") @db.VarChar(64)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  cabang         Cabang?   @relation(fields: [cabangId], references: [id], onDelete: Cascade)

  @@map("sesi")
}

model AbsensiSantri {
  id         String    @id @db.VarChar(64)
  tanggal    DateTime  @db.Date
  sesiId     String?   @map("sesi_id") @db.VarChar(64)
  santriId   String    @map("santri_id") @db.VarChar(64)
  status     String    @db.VarChar(32)
  keterangan String?   @db.Text
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  santri     Santri    @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@unique([tanggal, sesiId, santriId])
  @@map("absensi_santri")
}

model SetoranSantri {
  id          String    @id @db.VarChar(64)
  tanggal     DateTime  @db.Date
  santriId    String    @map("santri_id") @db.VarChar(64)
  pengampuId  String?   @map("pengampu_id") @db.VarChar(64)
  jenis       String?   @default("Ziyadah") @db.VarChar(32)
  surat       String    @db.VarChar(100)
  ayatMulai   Int       @map("ayat_mulai")
  ayatSelesai Int       @map("ayat_selesai")
  nilai       String?   @default("A") @db.VarChar(16)
  catatan     String?   @db.Text
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  santri      Santri    @relation(fields: [santriId], references: [id], onDelete: Cascade)
  pengampu    Pengampu? @relation(fields: [pengampuId], references: [id], onDelete: SetNull)

  @@map("setoran_santri")
}

model Izin {
  id              String    @id @db.VarChar(64)
  pemohonId       String    @map("pemohon_id") @db.VarChar(64)
  tipePemohon     String?   @default("Pengampu") @map("tipe_pemohon") @db.VarChar(32)
  jenis           String?   @default("Izin") @db.VarChar(32)
  tanggalMulai    DateTime  @map("tanggal_mulai") @db.Date
  tanggalSelesai  DateTime  @map("tanggal_selesai") @db.Date
  alasan          String    @db.Text
  tugasPengganti  String?   @map("tugas_pengganti") @db.Text
  statusApproval  String?   @default("Menunggu") @map("status_approval") @db.VarChar(32)
  buktiUrl        String?   @map("bukti_url") @db.Text
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("izin")
}

model MonitoringSigap {
  id           String    @id @db.VarChar(64)
  tanggal      DateTime  @db.Date
  pengampuId   String?   @map("pengampu_id") @db.VarChar(64)
  nama         String    @db.VarChar(150)
  nip          String?   @db.VarChar(64)
  role         String?   @db.VarChar(64)
  halaqah      String?   @db.VarChar(150)
  mapel        String?   @db.VarChar(150)
  kelas        String?   @db.VarChar(100)
  sesi         String?   @db.VarChar(64)
  jadwal       String?   @db.VarChar(64)
  jam          String?   @default("-") @db.VarChar(16)
  status       String    @db.VarChar(32)
  selisihMenit Int?      @default(0) @map("selisih_menit")
  lokasiGps    String?   @map("lokasi_gps") @db.VarChar(150)
  metode       String?   @default("Scan QR GPS") @db.VarChar(64)
  keterangan   String?   @db.Text
  alasanIzin   String?   @map("alasan_izin") @db.Text
  tugasSiswa   String?   @map("tugas_siswa") @db.Text
  manual       Boolean?  @default(false)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  pengampu     Pengampu? @relation(fields: [pengampuId], references: [id], onDelete: SetNull)

  @@map("monitoring_sigap")
}

model PembayaranSPP {
  id           String    @id @db.VarChar(64)
  invoiceNo    String    @unique @map("invoice_no") @db.VarChar(64)
  santriId     String    @map("santri_id") @db.VarChar(64)
  santriNama   String    @map("santri_nama") @db.VarChar(150)
  nis          String?   @db.VarChar(64)
  kelas        String?   @db.VarChar(50)
  cabangId     String?   @map("cabang_id") @db.VarChar(64)
  bulan        String    @db.VarChar(32)
  tahun        Int       @default(2026)
  nominal      Int       @default(350000)
  status       String    @default("Lunas") @db.VarChar(32)
  tanggalBayar DateTime? @map("tanggal_bayar") @db.Date
  metodeBayar  String?   @default("Transfer Bank BSI") @map("metode_bayar") @db.VarChar(64)
  nomorRef     String?   @map("nomor_ref") @db.VarChar(100)
  catatan      String?   @db.Text
  namaPetugas  String?   @default("Bendahara Pesantren") @map("nama_petugas") @db.VarChar(100)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  santri       Santri    @relation(fields: [santriId], references: [id], onDelete: Cascade)
  cabang       Cabang?   @relation(fields: [cabangId], references: [id], onDelete: SetNull)

  @@map("pembayaran_spp")
}

model Kelas {
  id          String    @id @db.VarChar(64)
  nama        String    @db.VarChar(100)
  unitSekolah String?   @default("MA IHYA AS-SUNNAH") @map("unit_sekolah") @db.VarChar(100)
  waliKelas   String?   @map("wali_kelas") @db.VarChar(150)
  cabangId    String?   @map("cabang_id") @db.VarChar(64)
  aktif       Boolean?  @default(true)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  cabang      Cabang?   @relation(fields: [cabangId], references: [id], onDelete: Cascade)

  @@map("kelas")
}

model Alumni {
  id         String    @id @db.VarChar(64)
  nama       String    @db.VarChar(150)
  nik        String?   @db.VarChar(50)
  nisn       String?   @db.VarChar(50)
  nism       String?   @db.VarChar(50)
  lp         String?   @default("L") @db.VarChar(10)
  tahunLulus String?   @default("2026") @map("tahun_lulus") @db.VarChar(16)
  cabangId   String?   @map("cabang_id") @db.VarChar(64)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  cabang     Cabang?   @relation(fields: [cabangId], references: [id], onDelete: Cascade)

  @@map("alumni")
}

model LokasiQr {
  id          String    @id @db.VarChar(64)
  kelas       String?   @db.VarChar(100)
  lokasi      String    @db.VarChar(255)
  kodeManual  String?   @map("kode_manual") @db.VarChar(64)
  cabangId    String?   @map("cabang_id") @db.VarChar(64)
  gpsStatus   String?   @default("GPS: Locked") @map("gps_status") @db.VarChar(64)
  locked      Boolean?  @default(true)
  lat         Float?
  lng         Float?
  radiusMeter Int?      @default(50) @map("radius_meter")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  cabang      Cabang?   @relation(fields: [cabangId], references: [id], onDelete: Cascade)

  @@map("lokasi_qr")
}

model Settings {
  key       String    @id @db.VarChar(64)
  value     Json
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model RaporTemplate {
  id              String    @id @default("default-template") @db.VarChar(64)
  namaYayasan     String?   @default("YAYASAN IHYA AS SUNNAH TASIKMALAYA") @map("nama_yayasan") @db.VarChar(255)
  namaMadrasah    String?   @default("MADRASAH ALIYAH IHYA AS SUNNAH") @map("nama_madrasah") @db.VarChar(255)
  alamatMadrasah  String?   @default("Kompleks Islamic Center PPIAS, Jl. Paseh No. 12, Tasikmalaya, Jawa Barat") @map("alamat_madrasah") @db.Text
  website         String?   @default("www.ma-ihyaassunnah.sch.id") @db.VarChar(150)
  email           String?   @default("tahfidz@ma-ihyaassunnah.sch.id") @db.VarChar(150)
  judulRapor      String?   @default("LEMBAR EVALUASI & RAPOR TAHFIDZ AL-QUR'AN") @map("judul_rapor") @db.VarChar(255)
  semester        String?   @default("Ganjil 2026/2027") @db.VarChar(100)
  namaMudir       String?   @default("Ustadz Dr. Abu Haidar, M.Pd.I") @map("nama_mudir") @db.VarChar(150)
  nipMudir        String?   @default("197501012000031001") @map("nip_mudir") @db.VarChar(64)
  tempatTanggal   String?   @default("Tasikmalaya, 20 Desember 2026") @map("tempat_tanggal") @db.VarChar(100)
  aspekPenilaian  Json?     @map("aspek_penilaian")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("rapor_template")
}

model NilaiRapor {
  id             String    @id @db.VarChar(64)
  santriId       String    @map("santri_id") @db.VarChar(64)
  pengampuId     String?   @map("pengampu_id") @db.VarChar(64)
  semester       String?   @default("Ganjil 2026/2027") @db.VarChar(100)
  tahunAjaran    String?   @default("2026/2027") @map("tahun_ajaran") @db.VarChar(32)
  
  // 4 Aspek Kualitas Tahfidz Utama (Sesuai Gambar 2)
  kelancaran     Int?      @default(90) // Kelancaran & Daya Ingat (Al-Hifdz)
  tajwid         Int?      @default(91) // Ahkamut Tajwid (Hukum Tajwid)
  fashohah       Int?      @default(89) // Makharijul Huruf & Shifat (Fashohah)
  adab           Int?      @default(95) // Adab Halaqah & Tilawah

  // Keterangan / Evaluasi
  evalKelancaran String?   @default("Hafalan lancar, tartil, dan mutqin") @map("eval_kelancaran") @db.Text
  evalTajwid     String?   @default("Ghunnah, ikhfa', dan mad diterapkan dengan baik") @map("eval_tajwid") @db.Text
  evalFashohah   String?   @default("Pengucapan huruf jelas dan fasih sesuai kaidah") @map("eval_fashohah") @db.Text
  evalAdab       String?   @default("Menghormati mushaf, ustadz, dan teman halaqah") @map("eval_adab") @db.Text

  // Rata-rata & Predikat Keseluruhan
  rataRata       Float?    @default(91.25) @map("rata_rata")
  predikat       String?   @default("Mumtaz (Istimewa)") @db.VarChar(50)
  catatanMusyrif String?   @map("catatan_musyrif") @db.Text
  tempatRapor    String?   @default("Tasikmalaya") @map("tempat_rapor") @db.VarChar(100)
  tanggalRapor   String?   @default("2026-12-20") @map("tanggal_rapor") @db.VarChar(64)

  aspekDetail    Json?     @map("aspek_detail")

  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  santri         Santri    @relation(fields: [santriId], references: [id], onDelete: Cascade)
  pengampu       Pengampu? @relation(fields: [pengampuId], references: [id], onDelete: SetNull)

  @@unique([santriId, semester])
  @@map("nilai_rapor")
}

model FotoProfil {
  id        String    @id @db.VarChar(64)
  userId    String    @map("user_id") @db.VarChar(64)
  userType  String    @map("user_type") @db.VarChar(32)
  nama      String    @db.VarChar(150)
  username  String?   @db.VarChar(100)
  nip       String?   @db.VarChar(64)
  role      String?   @db.VarChar(64)
  cabangId  String?   @map("cabang_id") @db.VarChar(64)
  fotoUrl   String    @map("foto_url") @db.Text
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cabang    Cabang?   @relation(fields: [cabangId], references: [id], onDelete: Cascade)

  @@unique([userId, userType])
  @@map("foto_profil")
}
